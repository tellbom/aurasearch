{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Elasticsearch": {
    "Endpoint": "http://elasticsearch:9200",
    "IndexAlias": "news-read",
    "TimeoutMs": 2000,
    "ResultVersion": "es-v1"
  },
  "Vespa": {
    "Endpoint": "http://vespa:8080",
    "Namespace": "news",
    "DocumentType": "news",
    "RankProfile": "cjk_bm25_all",
    "TimeoutMs": 2000
  },
  "Fusion": {
    "EsTopK": 50,
    "VespaTopK": 50,
    "FinalTopK": 20,
    "RankConstant": 60,
    "EsWeight": 1.0,
    "VespaWeight": 1.0,
    "MaxFusionDepth": 50,
    "GlobalTimeoutMs": 3000
  },
  "Indexing": {
    "SqlitePath": "data/search.db",
    "BatchSizeLimit": 200,
    "MaxRetryCount": 8,
    "WorkerPollIntervalMs": 1000,
    "HtmlMaxLength": 200000,
    "ElasticsearchSinkEnabled": true,
    "VespaSinkEnabled": true
  },
  "Telemetry": {
    "RetentionDays": 90,
    "CleanupBatchSize": 1000,
    "StoreRawQuery": false,
    "AllowRepeatedClicks": false
  },
  "SearchMode": {
    "Default": "EsOnly",
    "RequireReadinessForVespa": true
  },
  "Readiness": {
    "BackfillComplete": false,
    "MinimumOneHourSyncRate": 0.99,
    "Minimum24HourSyncRate": 0.995,
    "MaximumOutboxBacklog": 100,
    "MaximumLagMinutes": 10,
    "CheckIntervalSeconds": 60,
    "HashSampleSize": 100
  }
}
